{
  "name": "chaoticexplorables",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "chaoticexplorables",
      "workspaces": [
        "packages/*",
        "apps/*/*"
      ]
    },
    "node_modules/@chaoticexplorables/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@chaoticexplorables/double-pendulum": {
      "resolved": "packages/double-pendulum",
      "link": true
    },
    "packages/core": {
      "name": "@chaoticexplorables/core",
      "version": "0.0.1",
      "license": "MIT"
    },
    "packages/double-pendulum": {
      "name": "@chaoticexplorables/double-pendulum",
      "version": "0.0.1",
      "license": "MIT",
      "dependencies": {
        "@chaoticexplorables/core": "0.0.1"
      }
    }
  }
}
